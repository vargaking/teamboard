# Copy to .env before `docker compose up`
SECRET_KEY=replace-with-a-long-random-string-openssl-rand-hex-32
POSTGRES_USER=teamboard
POSTGRES_PASSWORD=teamboard
POSTGRES_DB=teamboard
WEB_PORT=8080
SEED_ON_STARTUP=true
SEED_PASSWORD=changeme

# --- Production behind a host nginx (see deploy/) ---
# WEB_BIND=127.0.0.1
# CORS_ORIGINS=["https://board.example.com"]
# PUBLIC_URL=https://board.example.com   # HTTPS required for the claude.ai connector (OAuth)
# VITE_BASE=/board/          # only for path-prefix deployments (deploy/host-nginx-paths.conf)
