      "minSeconds": 8,
      "lines": [
        {
          "file": "audio/voice/intro_0.wav",
          "seconds": 4.413,
          "text": "This is TeamBoard: the kanban board built for Lucrum, our SEP team."
        },
        {
          "file": "audio/voice/intro_1.wav",
          "seconds": 1.301,
          "text": "Think Trello, but ours."
        }
      ]
    },
    {
      "id": "boards",
      "minSeconds": 18,
      "lines": [
        {
          "file": "audio/voice/boards_0.wav",
          "seconds": 1.9,
          "text": "Every workstream gets its own board."
        },
        {
          "file": "audio/voice/boards_1.wav",
          "seconds": 5.324,
          "text": "Columns hold cards, with coloured labels, due dates and the avatars of whoever is on it."
        },
        {
          "file": "audio/voice/boards_2.wav",
          "seconds": 3.057,
          "text": "Finished something? Just drag the card to the next column."
        }
      ]
    },
    {
      "id": "live",
      "minSeconds": 13,
      "lines": [
        {
          "file": "audio/voice/live_0.wav",
          "seconds": 1.782,
          "text": "And everyone sees it instantly."
        },
        {
          "file": "audio/voice/live_1.wav",
          "seconds": 3.945,
          "text": "When Miki moves a card, it moves on your screen too. No refresh."
        },
        {
          "file": "audio/voice/live_2.wav",
          "seconds": 1.979,
          "text": "The green Live dot means you're in sync."
        }
      ]
    },
