        },
        {
          "file": "audio/voice/filters_1.wav",
          "seconds": 2.944,
          "text": "Right-click any card or column for quick actions."
        },
        {
          "file": "audio/voice/filters_2.wav",
          "seconds": 1.684,
          "text": "And yes, there's a dark mode."
        }
      ]
    },
    {
