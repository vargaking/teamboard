      "minSeconds": 13,
      "lines": [
        {
          "file": "audio/voice/details_0.wav",
          "seconds": 4.165,
          "text": "Open a card for the full picture: description, due date and assignees."
        },
        {
          "file": "audio/voice/details_1.wav",
          "seconds": 5.226,
          "text": "Reviewers get the eye icon, labels keep things sorted, and comments hold the discussion."
        }
      ]
    },
    {
      "id": "filters",
      "minSeconds": 14,
      "lines": [
        {
          "file": "audio/voice/filters_0.wav",
