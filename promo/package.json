{
  "name": "teamboard-promo",
  "private": true,
  "version": "1.0.0",
  "description": "TeamBoard promo + how-to video (Remotion)",
  "scripts": {
    "studio": "remotion studio",
    "capture": "python3 capture/capture.py",
    "voice": ".work/ttsvenv/bin/python audio/make_voice.py",
    "music": "python3 audio/make_music.py 134",
    "render": "remotion render src/index.ts TeamBoardPromo out/teamboard-promo.mp4 && sh scripts/finalize.sh",
    "stills": "node scripts/stills.mjs out/stills 100 600 1100 1400 2200 2700 3300",
    "timeline": "tsx scripts/timeline.ts"
  },
  "dependencies": {
    "@remotion/cli": "4.0.532",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "tsx": "^4.19.2",
    "typescript": "5.6.3"
  }
}
